# =====================================================
# Variables de Entorno para Docker - SIAONDA V2
# =====================================================
# Copia este archivo a .env.docker y ajusta los valores

# =====================================================
# BASE DE DATOS (PostgreSQL)
# =====================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=siaonda
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/siaonda

# =====================================================
# BACKEND
# =====================================================
PORT=3000
NODE_ENV=production

# JWT Secrets (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=tu-secreto-jwt-super-seguro-cambiar-en-produccion
JWT_REFRESH_SECRET=tu-refresh-secret-super-seguro-cambiar-en-produccion

# URLs
FRONTEND_URL=http://localhost
API_URL=http://localhost:3000

# =====================================================
# PGADMIN
# =====================================================
PGADMIN_DEFAULT_EMAIL=admin@siaonda.com
PGADMIN_DEFAULT_PASSWORD=admin123

# =====================================================
# ZONA HORARIA
# =====================================================
TZ=America/Santo_Domingo
